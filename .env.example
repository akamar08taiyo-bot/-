# このファイルを .env に複製し、値を 1Password の参照（op://保管庫/項目/フィールド）にする。
# 実際のキーは 1Password の中だけにあり、.env には参照の文字列しか残らない（漏れても使えない）。
# スクリプトは ai-ecosystem/scripts/with-secrets.sh 経由で実行すると、実行中だけキーに置き換わる。
# ※ ANTHROPIC_API_KEY という名前は使わない（Claude Code 本体がサブスクではなくAPI課金に切り替わるため）。

# --- 判断AI（ジェブのAPI版）・Discordまとめ: Claude API ---
JUDGE_ANTHROPIC_API_KEY="op://AI/Anthropic API/credential"
JUDGE_MODEL="claude-opus-5-5"

# --- 画像の見た目判定・画像生成の予備: OpenAI API ---
OPENAI_API_KEY="op://AI/OpenAI API/credential"
OPENAI_VISION_MODEL="gpt-5"
OPENAI_IMAGE_MODEL="gpt-image-1"

# --- ナレーション: ElevenLabs ---
ELEVENLABS_API_KEY="op://AI/ElevenLabs/credential"
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL="eleven_multilingual_v2"

# --- 他のAIのコマンド名（入れている名前に合わせる） ---
GEMINI_CMD="gemini"
CODEX_CMD="codex"

# --- Discord ボット ---
DISCORD_BOT_TOKEN="op://AI/Discord Bot/credential"
DISCORD_CHANNEL_IDS=""
DISCORD_REPORT_CHANNEL_ID=""

# --- X（Twitter）API：下書き・予約投稿に使う場合だけ ---
X_API_KEY="op://AI/X API/api key"
X_API_SECRET="op://AI/X API/api secret"
X_ACCESS_TOKEN="op://AI/X API/access token"
X_ACCESS_TOKEN_SECRET="op://AI/X API/access token secret"

# --- Obsidian の保管庫（任意。設定するとセッションログや日次まとめも書き込む） ---
OBSIDIAN_VAULT=""
