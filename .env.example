# Firebase Web SDK config (client-safe; access control is enforced by firestore.rules, not by hiding these values).
# Get these values from Firebase Console > Project settings > Your apps > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Callable Cloud Function name used for AI meal decomposition (see functions/).
VITE_PARSE_MEAL_FUNCTION_NAME=parseMeal
