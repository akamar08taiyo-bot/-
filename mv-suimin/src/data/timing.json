 "lines": [
  {
   "id": "v1-1",
   "section": "v1",
   "text": "睡眠はショート　配信はロング　増やした時間に追われてどうする",
   "start": 1.43,
   "end": 5.677,
   "phrases": [
    {
     "text": "睡眠はショート",
     "start": 1.43,
     "end": 2.177
    },
    {
     "text": "配信はロング",
     "start": 2.177,
     "end": 3.524
    },
    {
     "text": "増やした時間に追われてどうする",
     "start": 3.524,
     "end": 5.677
    }
   ]
  },
  {
   "id": "v1-2",
   "section": "v1",
   "text": "時間は黒字　目元も黒字　帳簿に出ないクマまで増える",
   "start": 5.677,
   "end": 9.555,
   "phrases": [
    {
     "text": "時間は黒字",
     "start": 5.677,
     "end": 6.515
    },
    {
     "text": "目元も黒字",
     "start": 6.515,
     "end": 7.552
    },
    {
     "text": "帳簿に出ないクマまで増える",
     "start": 7.552,
     "end": 9.555
    }
   ]
  },
  {
   "id": "v1-3",
   "section": "v1",
   "text": "体が資本と言いながら　眠りを削って元本割れ",
   "start": 9.555,
   "end": 13.044,
   "phrases": [
    {
     "text": "体が資本と言いながら",
     "start": 9.555,
     "end": 11.285
    },
    {
     "text": "眠りを削って元本割れ",
     "start": 11.285,
     "end": 13.044
    }
   ]
  },
  {
   "id": "v1-4",
   "section": "v1",
   "text": "投資の損は口座に出るが　眠りの損なら顔に出る",
   "start": 13.044,
   "end": 16.753,
   "phrases": [
    {
     "text": "投資の損は口座に出るが",
     "start": 13.044,
     "end": 14.646
    },
    {
     "text": "眠りの損なら顔に出る",
     "start": 14.646,
     "end": 16.753
    }
   ]
  },
  {
   "id": "v1-5",
   "section": "v1",
   "text": "ベンチは上がる　まぶたは下がる　重りより重い午後の眠気",
   "start": 16.753,
   "end": 20.544,
   "phrases": [
    {
     "text": "ベンチは上がる",
     "start": 16.753,
     "end": 17.914
    },
    {
     "text": "まぶたは下がる",
     "start": 17.914,
     "end": 18.494
    },
    {
     "text": "重りより重い午後の眠気",
     "start": 18.494,
     "end": 20.544
    }
   ]
  },
  {
   "id": "v1-6",
   "section": "v1",
   "text": "懸垂で身体を引き上げても　引きずる眠気は降ろせない",
   "start": 20.544,
   "end": 24.752,
   "phrases": [
    {
     "text": "懸垂で身体を引き上げても",
     "start": 20.544,
     "end": 22.657
    },
    {
     "text": "引きずる眠気は降ろせない",
     "start": 22.657,
     "end": 24.752
    }
   ]
  },
  {
   "id": "v1-7",
   "section": "v1",
   "text": "黒いレンズで白を切る　サングラスの下じゃ夢の中",
   "start": 24.752,
   "end": 28.305,
   "phrases": [
    {
     "text": "黒いレンズで白を切る",
     "start": 24.752,
     "end": 26.262
    },
    {
     "text": "サングラスの下じゃ夢の中",
     "start": 26.262,
     "end": 28.305
    }
   ]
  },
  {
   "id": "v1-8",
   "section": "v1",
   "text": "レンズは遮光　寝息は実況　配信はオン　意識はオフ",
   "start": 28.305,
   "end": 32.758,
