{
  "name": "nostalgic-town-film",
  "version": "1.0.0",
  "private": true,
  "description": "架空なのに懐かしい街の一日を、AI 映像（Gemini 画像＋Veo 動画）と環境音で描く長尺作品のひな形",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "shots": "node scripts/render_shots.mjs",
    "stills": "node scripts/stills.mjs",
    "assemble": "python3 -I scripts/assemble.py --crf 21 --maxrate 10M --preset medium --preview"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.355",
    "@remotion/cli": "4.0.355",
    "@remotion/renderer": "4.0.355",
    "@types/react": "18.3.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.355",
    "typescript": "5.6.3"
  }
}
